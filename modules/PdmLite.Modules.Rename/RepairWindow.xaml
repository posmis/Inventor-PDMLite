<Window x:Class="PdmLite.Modules.Rename.RepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdmLite.Modules.Rename"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:RepairViewModel}"
        Title="Обновить связи проекта" Width="1100" Height="640" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="Pdm.Window" />
    </Window.Style>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Pdm.Toolbar}" BorderBrush="{StaticResource Pdm.Brush.Border}" Padding="10,8">
            <StackPanel>
                <TextBlock Text="Обновить связи проекта" Style="{StaticResource Pdm.Text.Title}" />
                <TextBlock Style="{StaticResource Pdm.Text.Hint}" TextWrapping="Wrap"
                           Text="Если файлы перенесли или переименовали в проводнике Windows, сборки и чертежи их теряют. Здесь — все потерянные ссылки проекта и файлы проекта с тем же именем; ссылки заменяются во всех документах, где они есть." />
                <TextBlock Text="{Binding Root}" Style="{StaticResource Pdm.Text.Hint}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Pdm.Brush.Toolbar}" BorderBrush="{StaticResource Pdm.Brush.Border}"
                BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Найти заново" Command="{Binding FindCommand}" Margin="0,0,8,0" MinWidth="110" />
                    <Button Content="Обновить связи" Command="{Binding RepairCommand}" IsDefault="True" Margin="0,0,8,0" MinWidth="130" />
                    <Button Content="Закрыть" IsCancel="True" Click="Close_OnClick" MinWidth="90" />
                </StackPanel>
                <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="80" Height="6" Margin="0,0,8,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Pdm.Text.Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,6">
            <TextBlock Text="{Binding Problems}" Foreground="{StaticResource Pdm.Brush.Error}" TextWrapping="Wrap" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Warnings}" Foreground="{StaticResource Pdm.Brush.Warning}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <DataGrid x:Name="Grid" Margin="6" ItemsSource="{Binding Links}" AutoGenerateColumns="False" CanUserAddRows="False"
                  SelectionMode="Single" HorizontalScrollBarVisibility="Auto" PreviewMouseRightButtonDown="Grid_OnPreviewMouseRightButtonDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Выбрать файл…" Click="ChooseFile_OnClick" FontWeight="SemiBold">
                        <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.OpenFolder}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Не восстанавливать" Click="Skip_OnClick">
                        <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.Exclude}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Показать найденный файл в проводнике Windows" Click="ShowChosen_OnClick">
                        <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.ShowInWindows}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Копировать имя файла" Click="CopyName_OnClick">
                        <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.CopyPath}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Потерянный файл" Width="2*" MinWidth="200" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Link.Missing}">
                                <Image Source="{Binding Link.Missing, Converter={StaticResource Pdm.FileIcon}}" Style="{StaticResource Pdm.Icon16}" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Где был" Binding="{Binding OldFolder}" Width="*" MinWidth="120" IsReadOnly="True" />
                <DataGridTextColumn Header="Где используется" Binding="{Binding UsedIn}" Width="*" MinWidth="150" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Найден в проекте" Width="2*" MinWidth="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="…" Padding="6,0" Margin="4,0,0,0" ToolTip="Выбрать файл" Click="ChooseFileRow_OnClick" />
                                <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Chosen, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="{Binding Chosen}" />
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="190" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
