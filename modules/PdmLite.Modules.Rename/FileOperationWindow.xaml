<Window x:Class="PdmLite.Modules.Rename.FileOperationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdmLite.Modules.Rename"
        xmlns:ui="clr-namespace:PdmLite.UI.Shared;assembly=PdmLite.UI.Shared"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:FileOperationViewModel}"
        Title="{Binding Title}" Width="1100" Height="720" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <Style x:Key="WrapCell" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="2,2" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="Pdm.Window" />
    </Window.Style>

    <DockPanel>
        <!-- Заголовок и поля ввода -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Pdm.Toolbar}" BorderBrush="{StaticResource Pdm.Brush.Border}" Padding="10,8">
            <StackPanel>
                <TextBlock Text="{Binding Header}" Style="{StaticResource Pdm.Text.Title}" TextTrimming="CharacterEllipsis" />

                <!-- Переименование папки -->
                <DockPanel Margin="0,8,0,0" Visibility="{Binding IsFolderRename, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Новое имя папки:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="FolderNameBox" Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                </DockPanel>

                <!-- Переименование файла: по правилу или своё имя -->
                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsFileRename, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="По правилу: обозначение и наименование" IsChecked="{Binding UseRule}" GroupName="NameMode" Margin="0,0,16,0" />
                        <RadioButton Content="Своё имя файла" IsChecked="{Binding UseCustomName}" GroupName="NameMode" />
                    </StackPanel>
                    <DockPanel Margin="0,6,0,0" Visibility="{Binding UseCustomName, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Имя файла (без расширения):" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="CustomNameBox" Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                    </DockPanel>
                </StackPanel>
                <Grid Margin="0,8,0,0" IsEnabled="{Binding UseRule}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsFileRename}" Value="True" />
                                        <Condition Binding="{Binding UseRule}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Обозначение:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="DesignationBox" Grid.Column="1" Text="{Binding Designation, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                    <TextBlock Grid.Column="2" Text="Наименование:" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox Grid.Column="3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox Content="Записать обозначение и наименование в iProperties" IsChecked="{Binding WriteProperties}" Margin="0,0,16,0" />
                        <CheckBox Content="Вместе со связанными файлами" IsChecked="{Binding IncludeRelated}" Margin="0,0,16,0" />
                        <TextBlock Style="{StaticResource Pdm.Text.Hint}" VerticalAlignment="Center"
                                   Text="Имя: {Обозначение}{Код} {Наименование} — код документа (СБ, МЭ…) у каждого файла сохраняется." />
                    </StackPanel>
                </Grid>

                <!-- Перемещение -->
                <Grid Margin="0,8,0,0" Visibility="{Binding IsMove, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Куда:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Grid.Column="1" Text="{Binding TargetFolder, Mode=OneWay}" IsReadOnly="True" />
                    <Button Grid.Column="2" Content="Выбрать папку…" Click="Browse_OnClick" Margin="6,0,0,0" />
                    <CheckBox Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0" IsChecked="{Binding IncludeRelated}"
                              Content="Вместе со связанными файлами (чертежи и другие документы с тем же обозначением)" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Кнопки и состояние -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Pdm.Brush.Toolbar}" BorderBrush="{StaticResource Pdm.Brush.Border}"
                BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Проверить" Command="{Binding CheckCommand}" Margin="0,0,8,0" MinWidth="100" />
                    <Button Content="{Binding ActionText}" Command="{Binding ExecuteCommand}" IsDefault="True" Margin="0,0,8,0" MinWidth="120" />
                    <Button Content="Отмена" IsCancel="True" Click="Close_OnClick" MinWidth="90" />
                </StackPanel>
                <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="80" Height="6" Margin="0,0,8,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Pdm.Text.Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Ошибки и замечания -->
        <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,6">
            <TextBlock Text="{Binding Problems}" Foreground="{StaticResource Pdm.Brush.Error}" TextWrapping="Wrap" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Warnings}" Foreground="{StaticResource Pdm.Brush.Warning}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Файлы — было → станет" Style="{StaticResource Pdm.Text.Section}" Margin="2,0,0,4" />
            <DataGrid Grid.Row="1" x:Name="FilesGrid" ItemsSource="{Binding Files}" AutoGenerateColumns="False" CanUserAddRows="False"
                      SelectionMode="Extended" ui:RightClickSelect.IsEnabled="True" HorizontalScrollBarVisibility="Auto">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Включить выделенные" Click="IncludeSelected_OnClick">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.Include}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Исключить выделенные" Click="ExcludeSelected_OnClick">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.Exclude}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Показать в проводнике Windows" Click="ShowFile_OnClick">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.ShowInWindows}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Копировать путь" Click="CopyPath_OnClick">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.CopyPath}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="30">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                          ToolTip="Включить в операцию" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Было" Width="2*" MinWidth="200" SortMemberPath="FromName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding From}">
                                    <Image Source="{Binding From, Converter={StaticResource Pdm.FileIcon}}" Style="{StaticResource Pdm.Icon16}" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding FromName}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Станет" Width="2*" MinWidth="200" SortMemberPath="ToName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="ToText" Text="{Binding ToName}" ToolTip="{Binding To}" VerticalAlignment="Center" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Changes}" Value="True">
                                        <Setter TargetName="ToText" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Include}" Value="False">
                                        <Setter TargetName="ToText" Property="Foreground" Value="{StaticResource Pdm.Brush.TextDisabled}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Папка" Binding="{Binding FromFolder}" Width="*" MinWidth="120" IsReadOnly="True" />
                    <DataGridTextColumn Header="Новая папка" Binding="{Binding ToFolder}" Width="*" MinWidth="120" IsReadOnly="True"
                                        Visibility="Collapsed" x:Name="ToFolderColumn" />
                    <DataGridTextColumn Header="Почему в списке" Binding="{Binding Note}" Width="170" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Text="{Binding ReferencesHeader}" Style="{StaticResource Pdm.Text.Section}" Margin="2,8,0,4" />
            <Grid Grid.Row="3">
                <DataGrid ItemsSource="{Binding References}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Документ" Binding="{Binding Name}" Width="2*" MinWidth="180" />
                        <DataGridTextColumn Header="Папка" Binding="{Binding Folder}" Width="*" MinWidth="120" />
                        <DataGridTextColumn Header="Ссылок" Binding="{Binding Count}" Width="60" />
                        <DataGridTextColumn Header="Что заменится" Binding="{Binding Details}" Width="3*" MinWidth="250"
                                            ElementStyle="{StaticResource WrapCell}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Text="Нажмите «Проверить» — появится список документов проекта, в которых заменятся ссылки.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Pdm.Text.Hint}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding References.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
