<Window x:Class="PdmLite.Modules.Scripts.ScriptsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PdmLite.UI.Shared;assembly=PdmLite.UI.Shared"
        Title="Утилиты" Width="900" Height="520" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ui:FileIconConverter x:Key="FileIcon" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="Pdm.Window" />
    </Window.Style>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Pdm.Toolbar}" BorderBrush="{StaticResource Pdm.Brush.Border}" Padding="10,6">
            <StackPanel>
                <TextBlock Text="Внешние утилиты" Style="{StaticResource Pdm.Text.Title}" />
                <TextBlock Style="{StaticResource Pdm.Text.Hint}" TextWrapping="Wrap"
                           Text="Отдельные программы и скрипты из папки утилит. PDM только запускает их — ничего не передаёт и ничего от них не получает; у каждой утилиты свои поля ввода." />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Pdm.Brush.Toolbar}" BorderBrush="{StaticResource Pdm.Brush.Border}"
                BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Запустить" Click="Run_OnClick" IsDefault="True" Margin="0,0,8,0" MinWidth="110" />
                    <Button Content="Открыть папку утилит" Click="OpenFolder_OnClick" Margin="0,0,8,0" />
                    <Button Content="Обновить" Click="Refresh_OnClick" Margin="0,0,8,0" />
                    <Button Content="Закрыть" IsCancel="True" Click="Close_OnClick" />
                </StackPanel>
                <TextBlock x:Name="FolderText" Style="{StaticResource Pdm.Text.Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <DataGrid x:Name="Grid" Margin="6" IsReadOnly="True" SelectionMode="Single" MouseDoubleClick="Grid_OnMouseDoubleClick"
                      ui:RightClickSelect.IsEnabled="True">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Запустить" Click="Run_OnClick" FontWeight="SemiBold" InputGestureText="Двойной щелчок" />
                        <MenuItem Header="Показать файл" Click="ShowFile_OnClick">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.ShowInWindows}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Утилита" Width="280">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Path}">
                                    <Image Source="{Binding Path, Converter={StaticResource FileIcon}}" Style="{StaticResource Pdm.Icon16}" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Что делает" Width="*" MinWidth="250" Binding="{Binding Description}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Margin" Value="0,3" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Файл" Width="200" Binding="{Binding FileName}" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Pdm.Text.Hint}"
                       TextAlignment="Center" Visibility="Collapsed"
                       Text="Утилит нет. Положите .cmd, .bat, .exe или .ps1 в папку утилит и нажмите «Обновить»." />
        </Grid>
    </DockPanel>
</Window>
