<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Description>Модуль «Утилиты»: запуск внешних скриптов из папки утилит. Утилиты не связаны с PDM — только запуск.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PdmLite.Core\PdmLite.Core.csproj" />
    <ProjectReference Include="..\..\src\PdmLite.UI.Shared\PdmLite.UI.Shared.csproj" />
  </ItemGroup>

  <!-- Утилиты, поставляемые с PdmLite: при первом запуске копируются в папку утилит пользователя. -->
  <ItemGroup>
    <None Include="..\..\tools\collect-components\*.*" Link="Scripts\collect-components\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
