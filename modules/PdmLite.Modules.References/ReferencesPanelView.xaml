<UserControl x:Class="PdmLite.Modules.References.ReferencesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:PdmLite.Modules.References"
             xmlns:ui="clr-namespace:PdmLite.UI.Shared;assembly=PdmLite.UI.Shared"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:ReferencesPanelViewModel}"
             d:DesignWidth="340" d:DesignHeight="500">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <ui:FileIconConverter x:Key="FileIcon" />
            <ui:IconKeyConverter x:Key="IconKey" />

            <!-- Документ в списке: значок файла, имя, обозначение и наименование; ненайденный — красным -->
            <DataTemplate x:Key="DocumentTemplate">
                <DockPanel Margin="0,2" ToolTip="{Binding Path}">
                    <Image DockPanel.Dock="Left" Source="{Binding Path, Converter={StaticResource FileIcon}}" Style="{StaticResource Pdm.Icon16}"
                           VerticalAlignment="Top" Margin="0,1,6,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LevelText}" Style="{StaticResource Pdm.Text.Hint}" Margin="6,0,0,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Exists}" Value="False">
                                            <Setter Property="Foreground" Value="#B3261E" />
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Pdm.Text.Hint}" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Designation, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Title, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </DataTemplate>

            <ContextMenu x:Key="RowMenu">
                <MenuItem Header="Открыть" Command="{Binding OpenCommand}" FontWeight="SemiBold" InputGestureText="Двойной щелчок">
                    <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.Open}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Показать файл" Command="{Binding ShowFileCommand}">
                    <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.ShowInWindows}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Копировать путь" Command="{Binding CopyPathCommand}">
                    <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.CopyPath}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Обновить" Command="{Binding LoadCommand}">
                    <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.Refresh}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Style>
        <StaticResource ResourceKey="Pdm.Panel" />
    </UserControl.Style>

    <Grid>
        <TextBlock Text="Выберите документ в дереве проекта" Style="{StaticResource Pdm.Text.Hint}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasItem, Converter={x:Static ui:InverseBoolToVisibilityConverter.Instance}}" />

        <DockPanel Visibility="{Binding HasItem, Converter={StaticResource BoolToVisibility}}" Margin="8,6">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource Pdm.Text.Title}" TextTrimming="CharacterEllipsis" />
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Pdm.Text.Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" Margin="0,2"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="60" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="60" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,6,0,4">
                    <CheckBox DockPanel.Dock="Right" Content="все уровни" IsChecked="{Binding AllLevels}" VerticalAlignment="Center"
                              ToolTip="Показать и сборки, в которые входят эти сборки (до верхней)" />
                    <TextBlock Style="{StaticResource Pdm.Text.Section}">
                        <Run Text="Где используется (" /><Run Text="{Binding UsedIn.Count, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </DockPanel>
                <ListBox Grid.Row="1" x:Name="UsedInList" ItemsSource="{Binding UsedIn}" ItemTemplate="{StaticResource DocumentTemplate}"
                         SelectionChanged="List_OnSelectionChanged" MouseDoubleClick="List_OnMouseDoubleClick"
                         ContextMenu="{StaticResource RowMenu}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                <TextBlock Grid.Row="2" Style="{StaticResource Pdm.Text.Section}" Margin="0,10,0,4">
                    <Run Text="Состав (" /><Run Text="{Binding Components.Count, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>
                <ListBox Grid.Row="3" x:Name="ComponentsList" ItemsSource="{Binding Components}" ItemTemplate="{StaticResource DocumentTemplate}"
                         SelectionChanged="List_OnSelectionChanged" MouseDoubleClick="List_OnMouseDoubleClick"
                         ContextMenu="{StaticResource RowMenu}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
