<Window x:Class="PdmLite.Modules.References.IndexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdmLite.Modules.References"
        xmlns:ui="clr-namespace:PdmLite.UI.Shared;assembly=PdmLite.UI.Shared"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:IndexViewModel}"
        Title="Индекс ссылок проекта" Width="1200" Height="760" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="Pdm.Window" />
    </Window.Style>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Pdm.Toolbar}" BorderBrush="{StaticResource Pdm.Brush.Border}">
            <ui:ToolbarPanel>
                <Button Style="{StaticResource Pdm.ToolButton}" Command="{Binding ScanCommand}" ToolTip="Прочитать новые и изменённые документы проекта">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Pdm.Icon.Cmd.Refresh}" Style="{StaticResource Pdm.Icon16}" />
                        <TextBlock Text="Обновить индекс" Margin="5,0,2,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Pdm.ToolButton}" Command="{Binding StopCommand}" ToolTip="Остановить (прочитанное сохранится)">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Pdm.Icon.Cmd.Exclude}" Style="{StaticResource Pdm.Icon16}" />
                        <TextBlock Text="Остановить" Margin="5,0,2,0" />
                    </StackPanel>
                </Button>
            </ui:ToolbarPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Pdm.Brush.Toolbar}" BorderBrush="{StaticResource Pdm.Brush.Border}"
                BorderThickness="0,1,0,0" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Закрыть" IsCancel="True" Click="Close_OnClick" />
                <TextBlock Style="{StaticResource Pdm.Text.Hint}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Индекс хранит, на какие файлы ссылается каждый документ проекта. Повторно читаются только изменившиеся документы." />
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="10,8,10,4">
            <TextBlock Text="{Binding ProjectText}" Style="{StaticResource Pdm.Text.Title}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <ProgressBar Height="4" Margin="0,4,0,0" Value="{Binding Progress}" Maximum="100"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Pdm.Text.Hint}" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <TabControl Margin="6">
            <TabItem>
                <TabItem.Header>
                    <TextBlock><Run Text="Ненайденные файлы (" /><Run Text="{Binding Broken.Count, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                </TabItem.Header>
                <DataGrid ItemsSource="{Binding Broken}" SelectedItem="{Binding Selected}" IsReadOnly="True" SelectionMode="Single" HorizontalScrollBarVisibility="Auto"
                          ui:RightClickSelect.IsEnabled="True" ui:NaturalSort.IsEnabled="True">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Копировать имена" Command="{Binding CopyNamesCommand}" FontWeight="SemiBold">
                                <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.CopyPath}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Копировать таблицу (для Excel)" Command="{Binding CopyListCommand}" />
                            <Separator />
                            <MenuItem Header="Показать документ, где используется" Command="{Binding ShowDocumentCommand}">
                                <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.ShowInWindows}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Файл (нет на диске)" Width="340" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}" VerticalAlignment="Center">
                                        <Image Source="{Binding Path, Converter={StaticResource Pdm.FileIcon}}" Style="{StaticResource Pdm.Icon16}" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding Name}" Foreground="#B3261E" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Где используется" Width="*" MinWidth="250" Binding="{Binding UsedInText}" />
                        <DataGridTextColumn Header="Где искали" Width="320" Binding="{Binding Folder}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock><Run Text="Найдены в библиотеке (" /><Run Text="{Binding FoundInLibrary.Count, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                </TabItem.Header>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Pdm.Text.Hint}" TextWrapping="Wrap" Margin="4,4,4,6"
                               Text="Этих файлов нет по пути, записанному в документах, но они есть в библиотеке (компонент переименован или переехал). Inventor с PdmLite находит их сам. Чтобы записать новые пути в сами документы — «Обновить связи проекта…» (лента PdmLite или меню дерева проекта)." />
                    <DataGrid ItemsSource="{Binding FoundInLibrary}" IsReadOnly="True" SelectionMode="Single" HorizontalScrollBarVisibility="Auto"
                              ui:RightClickSelect.IsEnabled="True" ui:NaturalSort.IsEnabled="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Файл (как записан)" Width="300" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}" VerticalAlignment="Center">
                                            <Image Source="{Binding Path, Converter={StaticResource Pdm.FileIcon}}" Style="{StaticResource Pdm.Icon16}" Margin="0,0,5,0" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Где сейчас (библиотека)" Width="*" MinWidth="250" Binding="{Binding FoundAt}" />
                            <DataGridTextColumn Header="Где используется" Width="*" MinWidth="200" Binding="{Binding UsedInText}" />
                            <DataGridTextColumn Header="Где искали" Width="260" Binding="{Binding Folder}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock><Run Text="Не прочитаны (" /><Run Text="{Binding Errors.Count, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                </TabItem.Header>
                <ListBox ItemsSource="{Binding Errors}" ToolTip="Например, DWG из AutoCAD (не Inventor) или повреждённый файл" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
