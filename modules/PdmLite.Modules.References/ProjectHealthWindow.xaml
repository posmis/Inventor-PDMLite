<Window x:Class="PdmLite.Modules.References.ProjectHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Состояние проекта" Width="1180" Height="800" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CompactCell" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style x:Key="SeverityCell" TargetType="TextBlock" BasedOn="{StaticResource CompactCell}">
                <Setter Property="Foreground" Value="{StaticResource Pdm.Brush.Warning}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Severity}" Value="Ошибка">
                        <Setter Property="Foreground" Value="{StaticResource Pdm.Brush.Error}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DetailText" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0,3" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style><StaticResource ResourceKey="Pdm.Window" /></Window.Style>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="ProjectText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="LocationText" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Pdm.Brush.TextSecondary}" Margin="0,4,0,10" />
            <WrapPanel>
                <Button x:Name="AnalyzeButton" Content="Анализировать заново" Click="Analyze_OnClick" Margin="0,0,8,0" />
                <Button x:Name="ReloadButton" Content="Открыть сохранённую" Click="Reload_OnClick" Margin="0,0,8,0" />
                <Button x:Name="StopButton" Content="Остановить" Click="Stop_OnClick" IsEnabled="False" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,4" />
            <TextBlock x:Name="SummaryText" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
            <ProgressBar x:Name="BusyProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="ProgressText" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="AllFilter" Content="Все (0)" GroupName="Severity" IsChecked="True" Click="Filter_OnClick" Margin="0,0,14,0" />
                    <RadioButton x:Name="ErrorFilter" Content="Ошибки (0)" GroupName="Severity" Click="Filter_OnClick" Margin="0,0,14,0" Foreground="{StaticResource Pdm.Brush.Error}" />
                    <RadioButton x:Name="WarningFilter" Content="Замечания (0)" GroupName="Severity" Click="Filter_OnClick" Margin="0,0,14,0" />
                </StackPanel>
                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Left" Text="Поиск" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="SearchBox" MinWidth="150" TextChanged="Search_OnTextChanged" KeyDown="Search_OnKeyDown"
                         ToolTip="Поиск по имени, полному пути и тексту замечания. Esc — очистить." AutomationProperties.Name="Поиск замечаний" />
                </DockPanel>
                <Button Grid.Column="2" Content="Очистить поиск" Click="ClearSearch_OnClick" Margin="6,0,0,0" />
            </Grid>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="SavedText" Foreground="{StaticResource Pdm.Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
            <Expander Header="Что проверяет анализатор" Margin="0,4,0,0">
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Сохранённые документы Inventor в папке проекта и их ссылки. OldVersions, скрытые и системные папки, символические ссылки исключены. Геометрия, коллизии и несохранённые изменения не проверяются." />
            </Expander>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="205" MinWidth="160" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" MinWidth="420" /></Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Проверки" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox x:Name="CategoryList" SelectionChanged="Category_OnSelectionChanged" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="100" /><RowDefinition Height="5" /><RowDefinition Height="200" MinHeight="100" /></Grid.RowDefinitions>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Копировать список" Click="Copy_OnClick" ToolTip="Копировать текущий отфильтрованный список с полными путями" />
                        <TextBlock x:Name="ResultText" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <DataGrid x:Name="IssuesGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                                  SelectionChanged="Issue_OnSelectionChanged" MouseDoubleClick="Issue_OnDoubleClick" CanUserAddRows="False" EnableRowVirtualization="True"
                                  HorizontalScrollBarVisibility="Disabled" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="105" ElementStyle="{StaticResource SeverityCell}" />
                                <DataGridTemplateColumn Header="Документ" Width="2*" MinWidth="140" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel Margin="0,3" ToolTip="{Binding Path}">
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource Pdm.Brush.TextSecondary}" />
                                        </StackPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Проверка" Binding="{Binding Category}" Width="*" MinWidth="100" ElementStyle="{StaticResource CompactCell}" />
                                <DataGridTextColumn Header="Кратко" Binding="{Binding Preview}" Width="2*" MinWidth="100" ElementStyle="{StaticResource CompactCell}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" IsHitTestVisible="False" Margin="20" />
                    </Grid>
                </DockPanel>
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" />
                <Border Grid.Row="2" Background="{StaticResource Pdm.Brush.Panel}" BorderBrush="{StaticResource Pdm.Brush.Border}" BorderThickness="1" Padding="10">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button x:Name="ShowFileButton" Content="Показать файл" Click="ShowFile_OnClick" IsEnabled="False" Margin="0,0,8,0" />
                            <Button x:Name="CopyPathButton" Content="Копировать путь" Click="CopyPath_OnClick" IsEnabled="False" Margin="0,0,8,0" />
                            <Button x:Name="CopyDetailButton" Content="Копировать замечание" Click="CopyDetail_OnClick" IsEnabled="False" />
                        </WrapPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock x:Name="DetailTitle" Text="Выберите замечание в списке" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBox x:Name="DetailPath" Style="{StaticResource DetailText}" />
                                <TextBox x:Name="DetailMessage" Style="{StaticResource DetailText}" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
