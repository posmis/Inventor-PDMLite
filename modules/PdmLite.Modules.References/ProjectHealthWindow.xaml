<Window x:Class="PdmLite.Modules.References.ProjectHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Состояние проекта" Width="1150" Height="760" MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style><StaticResource ResourceKey="Pdm.Window" /></Window.Style>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="ProjectText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="LocationText" TextWrapping="Wrap" Margin="0,4,0,10" />
            <WrapPanel>
                <Button x:Name="AnalyzeButton" Content="Полный анализ проекта" Click="Analyze_OnClick" Margin="0,0,8,0" />
                <Button x:Name="ReloadButton" Content="Открыть сохранённую карточку" Click="Reload_OnClick" Margin="0,0,8,0" />
                <Button x:Name="StopButton" Content="Остановить" Click="Stop_OnClick" IsEnabled="False" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,12,0,6" />
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock x:Name="ScopeText" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Проверяются сохранённые документы Inventor в папке проекта и их ссылки. OldVersions, скрытые и системные папки, символические ссылки исключены. Геометрия и работоспособность моделей в Inventor не проверяются." />
            <ProgressBar x:Name="BusyProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" />
            <TextBlock x:Name="ProgressText" TextWrapping="Wrap" Margin="0,6,0,6" />
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Показать файл в проводнике" Click="ShowFile_OnClick" Margin="0,0,8,0" />
                <Button Content="Копировать замечания" Click="Copy_OnClick" />
            </WrapPanel>
        </StackPanel>
        <TextBlock x:Name="SavedText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0" />
        <DataGrid x:Name="IssuesGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single"
                  CanUserAddRows="False" EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Уровень" Binding="{Binding Severity}" Width="130" />
                <DataGridTextColumn Header="Проверка" Binding="{Binding Category}" Width="180" />
                <DataGridTextColumn Header="Документ" Binding="{Binding Path}" Width="*" MinWidth="200" />
                <DataGridTextColumn Header="Подробности" Binding="{Binding Details}" Width="2*" MinWidth="250" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
