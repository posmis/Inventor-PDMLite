<UserControl x:Class="PdmLite.Modules.ProjectTree.Views.ProjectTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PdmLite.Modules.ProjectTree.ViewModels"
             xmlns:ui="clr-namespace:PdmLite.UI.Shared;assembly=PdmLite.UI.Shared"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProjectTreeViewModel}"
             d:DesignWidth="320" d:DesignHeight="500">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                <StackPanel x:Name="Row" Orientation="Horizontal">
                    <StackPanel.ToolTip>
                        <StackPanel>
                            <TextBlock Text="{Binding KindName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Item.Path}" />
                        </StackPanel>
                    </StackPanel.ToolTip>
                    <!-- Метка документа, активного в Inventor -->
                    <Rectangle x:Name="ActiveMark" Width="3" Height="14" Margin="0,0,3,0"
                               Fill="{StaticResource Pdm.Brush.Accent}" Visibility="Hidden" />
                    <Image x:Name="KindIcon" Source="{Binding Item, Converter={StaticResource Pdm.FileIcon}}"
                           Style="{StaticResource Pdm.Icon16}" Margin="0,0,5,0" />
                    <TextBlock x:Name="Title" Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
                <HierarchicalDataTemplate.Triggers>
                    <!-- Выделение нескольких (Ctrl/Shift + щелчок) -->
                    <DataTrigger Binding="{Binding IsMarked}" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{StaticResource Pdm.Brush.Selected}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter TargetName="ActiveMark" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Title" Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsFolder}" Value="True" />
                            <Condition Binding="{Binding IsExpanded}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="KindIcon" Property="Source" Value="{StaticResource Pdm.Icon.Folder.Open}" />
                    </MultiDataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Style>
        <StaticResource ResourceKey="Pdm.Panel" />
    </UserControl.Style>

    <DockPanel>
        <!-- Панель инструментов: поиск и действия -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Pdm.Toolbar}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0">
                    <ToggleButton Style="{StaticResource Pdm.ToolButton}" IsChecked="{Binding FollowActiveDocument}"
                                  ToolTip="Выделять документ, активный в Inventor">
                        <Image Source="{StaticResource Pdm.Icon.Cmd.FollowActive}" Style="{StaticResource Pdm.Icon16}" />
                    </ToggleButton>
                    <Button Style="{StaticResource Pdm.ToolButton}" Command="{Binding CollapseAllCommand}" ToolTip="Свернуть всё">
                        <Image Source="{StaticResource Pdm.Icon.Cmd.CollapseAll}" Style="{StaticResource Pdm.Icon16}" />
                    </Button>
                    <Button Style="{StaticResource Pdm.ToolButton}" Command="{Binding RefreshCommand}" ToolTip="Обновить (F5)">
                        <Image Source="{StaticResource Pdm.Icon.Cmd.Refresh}" Style="{StaticResource Pdm.Icon16}" />
                    </Button>
                </StackPanel>
                <TextBox Style="{StaticResource Pdm.SearchBox}" Tag="Поиск по имени файла"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
            </DockPanel>
        </Border>

        <!-- Строка состояния панели -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Pdm.Brush.Toolbar}"
                BorderBrush="{StaticResource Pdm.Brush.Divider}" BorderThickness="0,1,0,0" Padding="6,3">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Pdm.Text.Hint}" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid>
            <TreeView x:Name="Tree" ItemsSource="{Binding Nodes}" AllowDrop="True"
                      PreviewMouseLeftButtonDown="Tree_OnPreviewMouseLeftButtonDown" PreviewMouseMove="Tree_OnPreviewMouseMove"
                      PreviewMouseLeftButtonUp="Tree_OnPreviewMouseLeftButtonUp"
                      DragOver="Tree_OnDragOver" Drop="Tree_OnDrop"
                      SelectedItemChanged="Tree_OnSelectedItemChanged"
                      ContextMenuOpening="Tree_OnContextMenuOpening">
                <TreeView.ContextMenu>
                    <ContextMenu />
                </TreeView.ContextMenu>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                        <EventSetter Event="Selected" Handler="TreeItem_OnSelected" />
                        <EventSetter Event="MouseDoubleClick" Handler="TreeItem_OnMouseDoubleClick" />
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeItem_OnPreviewMouseRightButtonDown" />
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Top"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
