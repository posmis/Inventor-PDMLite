<Window x:Class="PdmLite.Modules.Library.Import.BulkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Правка выделенных строк" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="Pdm.Window" />
    </Window.Style>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Применить" IsDefault="True" Click="Apply_OnClick" Margin="0,0,8,0" />
            <Button Content="Отмена" IsCancel="True" />
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="CountText" Style="{StaticResource Pdm.Text.Hint}" Margin="0,0,0,8" />

            <TextBlock Text="Поля (отмеченные будут заменены во всех выделенных строках)" Style="{StaticResource Pdm.Text.Section}" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <CheckBox x:Name="KindCheck" Content="Тип" VerticalAlignment="Center" />
                <ComboBox x:Name="KindBox" Grid.Column="1" Margin="0,3" IsEnabled="{Binding IsChecked, ElementName=KindCheck}" />

                <CheckBox x:Name="ManufacturerCheck" Grid.Row="1" Content="Производитель" VerticalAlignment="Center" />
                <TextBox x:Name="ManufacturerBox" Grid.Row="1" Grid.Column="1" Margin="0,3"
                         IsEnabled="{Binding IsChecked, ElementName=ManufacturerCheck}"
                         ToolTip="Пустое значение очищает поле" />

                <CheckBox x:Name="CategoryCheck" Grid.Row="2" Content="Раздел" VerticalAlignment="Center" />
                <ComboBox x:Name="CategoryBox" Grid.Row="2" Grid.Column="1" Margin="0,3" DisplayMemberPath="Path"
                          IsTextSearchEnabled="True" TextSearch.TextPath="Path"
                          IsEnabled="{Binding IsChecked, ElementName=CategoryCheck}" />
            </Grid>

            <TextBlock Text="Замена в обозначении" Style="{StaticResource Pdm.Text.Section}" Margin="0,14,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Найти" Style="{StaticResource Pdm.Text.Label}" VerticalAlignment="Center" />
                <TextBox x:Name="FindBox" Grid.Column="1" Margin="0,3" TextChanged="Replace_OnChanged" />
                <TextBlock Grid.Row="1" Text="Заменить на" Style="{StaticResource Pdm.Text.Label}" VerticalAlignment="Center" />
                <TextBox x:Name="ReplaceBox" Grid.Row="1" Grid.Column="1" Margin="0,3" TextChanged="Replace_OnChanged" />
                <CheckBox x:Name="RegexCheck" Grid.Row="2" Grid.Column="1" Margin="0,4" Click="Replace_OnChanged"
                          Content="Регулярное выражение ($1, $2 — найденные группы)" />
                <TextBlock x:Name="PreviewText" Grid.Row="3" Grid.Column="1" Style="{StaticResource Pdm.Text.Hint}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
            </Grid>
            <TextBlock Style="{StaticResource Pdm.Text.Hint}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Изменённые заменой обозначения считаются исправленными вручную: правила к ним больше не применяются." />
        </StackPanel>
    </DockPanel>
</Window>
