<Window x:Class="PdmLite.Modules.Library.Checks.LibraryPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PdmLite.UI.Shared;assembly=PdmLite.UI.Shared"
        Title="Выбрать компонент из библиотеки" Width="1050" Height="720" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="Pdm.Window" />
    </Window.Style>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="ForText" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBox x:Name="SearchBox" Style="{StaticResource Pdm.SearchBox}" Tag="Поиск по обозначению или разделу"
                     TextChanged="Search_OnTextChanged" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="Выбрать" IsDefault="True" Click="Ok_OnClick" Margin="0,0,8,0" MinWidth="100" IsEnabled="False" />
                <Button Content="Отмена" IsCancel="True" />
            </StackPanel>
            <TextBlock x:Name="CountText" Style="{StaticResource Pdm.Text.Hint}" VerticalAlignment="Center" />
        </DockPanel>

        <DataGrid x:Name="Grid" ui:NaturalSort.IsEnabled="True" ui:RightClickSelect.IsEnabled="True" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="Grid_OnSelectionChanged" MouseDoubleClick="Grid_OnMouseDoubleClick">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Выбрать" Click="Ok_OnClick" FontWeight="SemiBold" />
                    <MenuItem Header="Копировать обозначение" Click="Copy_OnClick">
                        <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.CopyPath}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Обозначение" Width="380" Binding="{Binding Designation}" SortMemberPath="Designation" />
                <DataGridTextColumn Header="Раздел" Width="200" Binding="{Binding CategoryPath}" />
                <DataGridTextColumn Header="Стандарт / производитель" Width="*" Binding="{Binding Detail}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
