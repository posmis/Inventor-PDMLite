<Window x:Class="PdmLite.Modules.Library.Checks.MissingFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PdmLite.UI.Shared;assembly=PdmLite.UI.Shared"
        Title="Ненайденные файлы сборки" Width="900" Height="640" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="Pdm.Window" />
    </Window.Style>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Pdm.Toolbar}" BorderBrush="{StaticResource Pdm.Brush.Border}" Padding="10,6">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource Pdm.Text.Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource Pdm.Text.Hint}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Pdm.Brush.Toolbar}" BorderBrush="{StaticResource Pdm.Brush.Border}"
                BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Копировать имена" Click="CopyNames_OnClick" Margin="0,0,8,0" MinWidth="140" IsDefault="True"
                            ToolTip="Имена файлов — по одному на строку" />
                    <Button Content="Копировать с путями" Click="CopyPaths_OnClick" Margin="0,0,8,0" />
                    <Button Content="Обновить" Click="Refresh_OnClick" Margin="0,0,8,0" />
                    <Button Content="Закрыть" IsCancel="True" Click="Close_OnClick" />
                </StackPanel>
                <TextBlock Style="{StaticResource Pdm.Text.Hint}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Файлы, которые сборка (со всеми подсборками) не может найти на этом компьютере." />
            </DockPanel>
        </Border>

        <DataGrid x:Name="Grid" Margin="6" IsReadOnly="True" SelectionMode="Extended"
                  ui:RightClickSelect.IsEnabled="True" ui:NaturalSort.IsEnabled="True">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Копировать имя" Click="CopySelectedNames_OnClick" FontWeight="SemiBold" />
                    <MenuItem Header="Копировать путь" Click="CopySelectedPaths_OnClick" />
                    <Separator />
                    <MenuItem Header="Копировать все имена" Click="CopyNames_OnClick" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Файл" Width="400" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Path}">
                                <Image Source="{Binding Path, Converter={StaticResource Pdm.FileIcon}}" Style="{StaticResource Pdm.Icon16}" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Шт." Width="50" Binding="{Binding Count}" />
                <DataGridTextColumn Header="Где искали" Width="*" MinWidth="200" Binding="{Binding Folder}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
