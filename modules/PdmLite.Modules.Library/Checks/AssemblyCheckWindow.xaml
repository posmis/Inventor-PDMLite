<Window x:Class="PdmLite.Modules.Library.Checks.AssemblyCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdmLite.Modules.Library.Checks"
        xmlns:ui="clr-namespace:PdmLite.UI.Shared;assembly=PdmLite.UI.Shared"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:AssemblyCheckViewModel}"
        Title="Проверка сборки: стандартные компоненты" Width="1450" Height="800" MinWidth="700" MinHeight="300"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ui:IconKeyConverter x:Key="IconKey" />
            <ui:FileIconConverter x:Key="FileIcon" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="Pdm.Window" />
    </Window.Style>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Pdm.Toolbar}" BorderBrush="{StaticResource Pdm.Brush.Border}" Padding="10,6">
            <StackPanel>
                <TextBlock Text="{Binding Header}" Style="{StaticResource Pdm.Text.Title}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Pdm.Text.Hint}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Pdm.Brush.Toolbar}" BorderBrush="{StaticResource Pdm.Brush.Border}"
                BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding ReplaceCommand}" Margin="0,0,8,0" MinWidth="190">
                        <TextBlock>
                            <Run Text="Заменить отмеченные (" /><Run Text="{Binding ToReplace, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </Button>
                    <Button Command="{Binding FixNamesCommand}" Margin="0,0,8,0"
                            ToolTip="Вхождения компонентов библиотеки со старыми именами (например, от Content Center) получат имя по файлу">
                        <TextBlock>
                            <Run Text="Обновить имена в обозревателе (" /><Run Text="{Binding NamesToFix, Mode=OneWay}" /><Run Text=")…" />
                        </TextBlock>
                    </Button>
                    <Button Content="Проверить заново" Command="{Binding RunCommand}" Margin="0,0,8,0" />
                    <Button Content="Закрыть" IsCancel="True" Click="Close_OnClick" />
                </StackPanel>
                <TextBlock Style="{StaticResource Pdm.Text.Hint}" VerticalAlignment="Center"
                           Text="Перед заменой сборки копируются в %LOCALAPPDATA%\PdmLite\backups. Изменённые сборки сохраните в Inventor." />
            </DockPanel>
        </Border>

        <Grid Margin="6">
            <DataGrid x:Name="Grid" ui:NaturalSort.IsEnabled="True" ui:RightClickSelect.IsEnabled="True" ItemsSource="{Binding Rows}" IsReadOnly="False"
                      HorizontalScrollBarVisibility="Auto" MinRowHeight="28">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Выбрать замену из библиотеки…" Click="ChooseSelected_OnClick" FontWeight="SemiBold">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.Library}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Отметить для замены" Click="Mark_OnClick">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.Include}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Снять отметку" Click="Unmark_OnClick">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.Exclude}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Показать файл" Click="ShowFile_OnClick">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.ShowInWindows}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Копировать обозначение" Click="CopyDesignation_OnClick">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.CopyPath}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Проверить заново" Command="{Binding RunCommand}">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.Refresh}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="30" CanUserResize="False" SortMemberPath="Replace">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Replace, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanReplace}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Заменить на компонент из библиотеки" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Компонент в сборке" Width="330" SortMemberPath="Designation">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding FilePath}" VerticalAlignment="Center">
                                    <Image Source="{Binding FilePath, Converter={StaticResource FileIcon}}" Style="{StaticResource Pdm.Icon16}" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding Designation}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Шт." Width="45" Binding="{Binding Count, Mode=OneWay}" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="0,0,4,0" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Замена из библиотеки" Width="460" MinWidth="300" SortMemberPath="ReplacementText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Pdm.ToolButton}" Click="Choose_OnClick" Margin="6,0,0,0"
                                            ToolTip="Выбрать замену из библиотеки вручную">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{StaticResource Pdm.Icon.Cmd.Library}" Style="{StaticResource Pdm.Icon16}" />
                                            <TextBlock Text="Выбрать…" Margin="4,0,2,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Grid VerticalAlignment="Center">
                                        <!-- Один вариант или ничего — текст; несколько — выбор из списка -->
                                        <TextBlock Text="{Binding ReplacementText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding ReplacementText}"
                                                   Visibility="{Binding HasChoice, Converter={x:Static ui:InverseBoolToVisibilityConverter.Instance}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanReplace}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource Pdm.Brush.TextSecondary}" />
                                                            <Setter Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Text" ToolTip="Несколько похожих компонентов — выберите нужный"
                                                  Visibility="{Binding HasChoice, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Замечание" Width="400" MinWidth="200" SortMemberPath="FindingText">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Message}" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon, Converter={StaticResource IconKey}}" Style="{StaticResource Pdm.Icon16}" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding FindingText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Message, StringFormat=' — {0}'}" Style="{StaticResource Pdm.Text.Hint}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Top"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</Window>
