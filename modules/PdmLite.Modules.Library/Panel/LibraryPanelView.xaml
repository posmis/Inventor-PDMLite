<UserControl x:Class="PdmLite.Modules.Library.Panel.LibraryPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:PdmLite.Modules.Library.Panel"
             xmlns:ui="clr-namespace:PdmLite.UI.Shared;assembly=PdmLite.UI.Shared"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:LibraryPanelViewModel}"
             d:DesignWidth="320" d:DesignHeight="560">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <ui:FileIconConverter x:Key="FileIcon" />

            <HierarchicalDataTemplate DataType="{x:Type local:LibraryNode}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" ToolTip="{Binding Name}">
                    <Image x:Name="Icon" Source="{Binding FullPath, Converter={StaticResource FileIcon}}"
                           Style="{StaticResource Pdm.Icon16}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CountText}" Margin="5,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource Pdm.Brush.TextSecondary}" />
                </StackPanel>
                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                        <Setter TargetName="Icon" Property="Source" Value="{StaticResource Pdm.Icon.Folder}" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsFolder}" Value="True" />
                            <Condition Binding="{Binding IsExpanded}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="Icon" Property="Source" Value="{StaticResource Pdm.Icon.Folder.Open}" />
                    </MultiDataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Style>
        <StaticResource ResourceKey="Pdm.Panel" />
    </UserControl.Style>

    <DockPanel>
        <!-- Поиск и обновление -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Pdm.Toolbar}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Pdm.ToolButton}" Command="{Binding LoadCommand}"
                        ToolTip="Перечитать библиотеку" Margin="4,0,0,0">
                    <Image Source="{StaticResource Pdm.Icon.Cmd.Refresh}" Style="{StaticResource Pdm.Icon16}" />
                </Button>
                <TextBox Style="{StaticResource Pdm.SearchBox}" Tag="Поиск: M8, 7798, болт…"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
            </DockPanel>
        </Border>

        <!-- Библиотека не подключена к проекту Inventor -->
        <Border DockPanel.Dock="Top" Background="#FFF4CE" BorderBrush="#E8D48A" BorderThickness="0,0,0,1" Padding="8,6"
                Visibility="{Binding BindingNotice, Converter={x:Static ui:NullToVisibilityConverter.Instance}}">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="{StaticResource Pdm.Icon.State.Warning}" Style="{StaticResource Pdm.Icon16}"
                       VerticalAlignment="Top" Margin="0,0,6,0" />
                <StackPanel>
                    <TextBlock Text="{Binding BindingNotice}" TextWrapping="Wrap" />
                    <Button Content="Подключить к проекту" Command="{Binding ConnectLibraryCommand}" HorizontalAlignment="Left"
                            Margin="0,6,0,0" Visibility="{Binding CanConnectLibrary, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Выбранный компонент и действия -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Pdm.Brush.Toolbar}"
                BorderBrush="{StaticResource Pdm.Brush.Divider}" BorderThickness="0,1,0,0" Padding="8,6">
            <StackPanel>
                <StackPanel Visibility="{Binding SelectedItem, Converter={x:Static ui:NullToVisibilityConverter.Instance}}">
                    <TextBox Text="{Binding SelectedItem.Designation, Mode=OneWay}" Style="{StaticResource Pdm.Text.Value}"
                             FontWeight="SemiBold" Margin="0" />
                    <TextBlock Style="{StaticResource Pdm.Text.Hint}" Margin="0,2,0,6" TextTrimming="CharacterEllipsis"
                               Text="{Binding SelectedItem.CategoryPath}" />
                </StackPanel>
                <WrapPanel>
                    <Button Style="{StaticResource Pdm.ToolButton}" Command="{Binding PlaceCommand}" BorderBrush="#ADADAD"
                            ToolTip="Вставить в активную сборку Inventor (двойной щелчок)">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Pdm.Icon.Doc.Assembly}" Style="{StaticResource Pdm.Icon16}" />
                            <TextBlock Text="Вставить в сборку" Margin="5,0,2,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Pdm.ToolButton}" Command="{Binding OpenCommand}" ToolTip="Открыть компонент в Inventor">
                        <Image Source="{StaticResource Pdm.Icon.Cmd.Open}" Style="{StaticResource Pdm.Icon16}" />
                    </Button>
                    <Button Style="{StaticResource Pdm.ToolButton}" Command="{Binding ShowFileCommand}" ToolTip="Показать файл в проводнике Windows">
                        <Image Source="{StaticResource Pdm.Icon.Cmd.ShowInWindows}" Style="{StaticResource Pdm.Icon16}" />
                    </Button>
                </WrapPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Pdm.Text.Hint}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Grid>
            <TreeView x:Name="Tree" ItemsSource="{Binding Nodes}" SelectedItemChanged="Tree_OnSelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                        <EventSetter Event="MouseDoubleClick" Handler="TreeItem_OnMouseDoubleClick" />
                        <EventSetter Event="Selected" Handler="TreeItem_OnSelected" />
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>
            <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Top"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
