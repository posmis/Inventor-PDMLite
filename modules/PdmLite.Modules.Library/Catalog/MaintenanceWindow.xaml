<Window x:Class="PdmLite.Modules.Library.Catalog.MaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdmLite.Modules.Library.Catalog"
        xmlns:ui="clr-namespace:PdmLite.UI.Shared;assembly=PdmLite.UI.Shared"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MaintenanceViewModel}"
        Title="Обслуживание библиотеки: свойства в файлах" Width="1000" Height="620" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ui:IconKeyConverter x:Key="IconKey" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="Pdm.Window" />
    </Window.Style>

    <DockPanel Margin="12">
        <!-- Охват и шаг 1 -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Pdm.Text.Hint}" Margin="0,0,0,8"
                       Text="Сверяет свойства PdmLite в файлах компонентов с библиотекой: обозначение, SPEC_Section, стандарт, производитель, раздел, метка Content Center. Сначала — только проверка; файлы меняются лишь после «Применить к отмеченным»." />
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding CheckCommand}" MinWidth="120">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Pdm.Icon.Cmd.Check}" Style="{StaticResource Pdm.Icon16}" Margin="0,0,6,0" />
                        <TextBlock Text="Проверить" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <RadioButton IsChecked="{Binding OnlySelected}" IsEnabled="{Binding HasSelection}" Margin="0,2">
                        <TextBlock><Run Text="Выделенные в каталоге: " /><Run Text="{Binding SelectedCount, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                    <RadioButton IsChecked="{Binding OnlySelected, Converter={x:Static local:InverseBool.Instance}}" Margin="0,2">
                        <TextBlock><Run Text="Вся библиотека: " /><Run Text="{Binding TotalCount, Mode=OneWay}" /></TextBlock>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
            <ProgressBar Height="4" Margin="0,10,0,2" Value="{Binding Progress}" Maximum="100" />
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Pdm.Text.Hint}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,8" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Шаг 2 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Закрыть" IsCancel="True" Click="Close_OnClick" />
            <Button DockPanel.Dock="Right" Content="Остановить" Command="{Binding StopCommand}" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Right" Command="{Binding ApplyCommand}" Margin="0,0,8,0" MinWidth="200">
                <TextBlock><Run Text="Применить к отмеченным (" /><Run Text="{Binding ToApply, Mode=OneWay}" /><Run Text=")" /></TextBlock>
            </Button>
        </DockPanel>

        <!-- Диагностика: что изменится -->
        <DataGrid ui:NaturalSort.IsEnabled="True" ItemsSource="{Binding Rows}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="Height" Value="NaN" />
                    <Setter Property="MinHeight" Value="24" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="28" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Apply, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanApply}"
                                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Компонент" Width="340" SortMemberPath="Designation">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}" VerticalAlignment="Top" Margin="0,4">
                                <Image Source="{Binding Icon, Converter={StaticResource IconKey}}" Style="{StaticResource Pdm.Icon16}" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding Designation}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Что изменится в файле (свойство: сейчас → станет)" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ChangesText}" TextWrapping="Wrap" Margin="0,4" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
