<Window x:Class="PdmLite.Modules.Library.Catalog.MaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdmLite.Modules.Library.Catalog"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MaintenanceViewModel}"
        Title="Обслуживание библиотеки" Width="620" Height="460" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="Pdm.Window" />
    </Window.Style>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Начать" Command="{Binding StartCommand}" Margin="0,0,8,0" />
            <Button Content="Остановить" Command="{Binding StopCommand}" Margin="0,0,8,0" />
            <Button Content="Закрыть" IsCancel="True" Click="Close_OnClick" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Обновить свойства PdmLite в файлах" Style="{StaticResource Pdm.Text.Section}" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource Pdm.Text.Hint}" Margin="0,0,0,8"
                       Text="Записывает в файлы компонентов свойства по данным библиотеки: обозначение, SPEC_Section (стандартное или прочее изделие), стандарт, производитель, раздел. Нужно, когда добавилось новое свойство или свойства в файлах изменили вручную." />
            <RadioButton IsChecked="{Binding OnlySelected}" IsEnabled="{Binding HasSelection}" Margin="0,2">
                <TextBlock>
                    <Run Text="Выделенные в каталоге: " /><Run Text="{Binding SelectedCount, Mode=OneWay}" />
                </TextBlock>
            </RadioButton>
            <RadioButton Margin="0,2">
                <RadioButton.Style>
                    <Style TargetType="RadioButton">
                        <Setter Property="IsChecked" Value="{Binding OnlySelected, Converter={x:Static local:InverseBool.Instance}, Mode=TwoWay}" />
                    </Style>
                </RadioButton.Style>
                <TextBlock>
                    <Run Text="Вся библиотека: " /><Run Text="{Binding TotalCount, Mode=OneWay}" />
                </TextBlock>
            </RadioButton>
            <ProgressBar Height="6" Margin="0,12,0,4" Value="{Binding Progress}" Maximum="100" Foreground="{StaticResource Pdm.Brush.Accent}"
                         Background="{StaticResource Pdm.Brush.Divider}" />
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Pdm.Text.Hint}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Margin="0,6,0,6" FontWeight="SemiBold" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Failures}" BorderBrush="{StaticResource Pdm.Brush.Border}" />
    </DockPanel>
</Window>
