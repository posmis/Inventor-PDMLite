<Window x:Class="PdmLite.Modules.Library.Catalog.EditItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdmLite.Modules.Library.Catalog"
        xmlns:ui="clr-namespace:PdmLite.UI.Shared;assembly=PdmLite.UI.Shared"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:EditItemViewModel}"
        Title="{Binding Title}" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ui:IconKeyConverter x:Key="IconKey" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="Pdm.Window" />
    </Window.Style>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{Binding SaveText}" IsDefault="True" Click="Save_OnClick" Margin="0,0,8,0" IsEnabled="{Binding CanSave}" />
            <Button Content="Отмена" IsCancel="True" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="{Binding CurrentHeader}" Style="{StaticResource Pdm.Text.Section}" Margin="0,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Обозначение" Style="{StaticResource Pdm.Text.Label}" />
                <TextBox Grid.Column="1" Text="{Binding CurrentDesignation, Mode=OneWay}" Style="{StaticResource Pdm.Text.Value}" />
                <TextBlock Grid.Row="1" Text="Файл" Style="{StaticResource Pdm.Text.Label}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentPath, Mode=OneWay}" Style="{StaticResource Pdm.Text.Value}" />
            </Grid>

            <TextBlock Text="{Binding NewHeader}" Style="{StaticResource Pdm.Text.Section}" Margin="0,12,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Обозначение" Style="{StaticResource Pdm.Text.Label}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Designation, UpdateSourceTrigger=PropertyChanged, Delay=300}" Margin="0,3" />

                <TextBlock Grid.Row="1" Text="Тип" Style="{StaticResource Pdm.Text.Label}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding KindNames}" SelectedItem="{Binding KindName}" Margin="0,3" />

                <TextBlock Grid.Row="2" Text="Стандарт" Style="{StaticResource Pdm.Text.Label}" VerticalAlignment="Center" />
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,3">
                    <CheckBox DockPanel.Dock="Right" Content="вручную" IsChecked="{Binding StandardIsManual}" VerticalAlignment="Center" Margin="8,0,0,0"
                              ToolTip="Если стандарт распознан из обозначения неверно — укажите его сами" />
                    <Grid>
                        <TextBox Text="{Binding Standard, Mode=OneWay}" Style="{StaticResource Pdm.Text.Value}" VerticalAlignment="Center"
                                 Visibility="{Binding StandardIsManual, Converter={x:Static ui:InverseBoolToVisibilityConverter.Instance}}" />
                        <TextBox Text="{Binding ManualStandard, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                 Visibility="{Binding StandardIsManual, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </DockPanel>

                <TextBlock Grid.Row="3" Text="Производитель" Style="{StaticResource Pdm.Text.Label}" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged, Delay=300}" Margin="0,3" />

                <TextBlock Grid.Row="4" Text="Раздел" Style="{StaticResource Pdm.Text.Label}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
                          DisplayMemberPath="Path" Margin="0,3" />
            </Grid>

            <TextBlock Text="Проверка" Style="{StaticResource Pdm.Text.Section}" Margin="0,12,0,4" />
            <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <Image Source="{Binding Icon, Converter={StaticResource IconKey}}" Style="{StaticResource Pdm.Icon16}" VerticalAlignment="Top" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,6,0,0">
                <TextBlock Text="Будет в библиотеке" Style="{StaticResource Pdm.Text.Label}" Width="130" />
                <TextBox Text="{Binding NewPath, Mode=OneWay}" Style="{StaticResource Pdm.Text.Value}" />
            </DockPanel>
        </StackPanel>
    </DockPanel>
</Window>
