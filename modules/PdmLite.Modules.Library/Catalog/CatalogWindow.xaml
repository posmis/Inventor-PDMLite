<Window x:Class="PdmLite.Modules.Library.Catalog.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdmLite.Modules.Library.Catalog"
        xmlns:ui="clr-namespace:PdmLite.UI.Shared;assembly=PdmLite.UI.Shared"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:CatalogViewModel}"
        Title="Каталог библиотеки" Width="1450" Height="900" MinWidth="700" MinHeight="350"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="Pdm.Window" />
    </Window.Style>

    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Pdm.Toolbar}" BorderBrush="{StaticResource Pdm.Brush.Border}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBox Style="{StaticResource Pdm.SearchBox}" Tag="Поиск в выбранной папке" Width="240"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                </StackPanel>
                <ui:ToolbarPanel>
                    <Button Style="{StaticResource Pdm.ToolButton}" Click="Edit_OnClick" ToolTip="Изменить обозначение, тип, производителя или раздел (двойной щелчок)">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Pdm.Icon.Cmd.Settings}" Style="{StaticResource Pdm.Icon16}" />
                            <TextBlock Text="Изменить…" Margin="5,0,2,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Pdm.ToolButton}" Click="Duplicate_OnClick"
                            ToolTip="Копия компонента с другим обозначением (например, другое покрытие); размеры те же">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Pdm.Icon.Cmd.LibraryAdd}" Style="{StaticResource Pdm.Icon16}" />
                            <TextBlock Text="Дублировать…" Margin="5,0,2,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Pdm.ToolButton}" Click="Delete_OnClick" ToolTip="Удалить компонент из библиотеки">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Pdm.Icon.State.Error}" Style="{StaticResource Pdm.Icon16}" />
                            <TextBlock Text="Удалить" Margin="5,0,2,0" />
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource Pdm.ToolSeparator}" />
                    <Button Style="{StaticResource Pdm.ToolButton}" Click="ShowInWindows_OnClick" ToolTip="Показать файл в проводнике Windows">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Pdm.Icon.Cmd.ShowInWindows}" Style="{StaticResource Pdm.Icon16}" />
                            <TextBlock Text="Показать файл" Margin="5,0,2,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Pdm.ToolButton}" Command="{Binding LoadCommand}" ToolTip="Обновить список (F5)">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Pdm.Icon.Cmd.Refresh}" Style="{StaticResource Pdm.Icon16}" />
                            <TextBlock Text="Обновить" Margin="5,0,2,0" />
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource Pdm.ToolSeparator}" />
                    <Button Style="{StaticResource Pdm.ToolButton}" Click="Maintenance_OnClick"
                            ToolTip="Служебные операции: свойства PdmLite в файлах библиотеки, поиск и объединение дубликатов">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource Pdm.Icon.Cmd.Database}" Style="{StaticResource Pdm.Icon16}" />
                            <TextBlock Text="Обслуживание…" Margin="5,0,2,0" />
                        </StackPanel>
                    </Button>
                </ui:ToolbarPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Pdm.Brush.Toolbar}" BorderBrush="{StaticResource Pdm.Brush.Border}"
                BorderThickness="0,1,0,0" Padding="10,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Закрыть" IsCancel="True" Click="Close_OnClick" />
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="160" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Папки: раздел → группа → стандарт или производитель -->
            <TreeView x:Name="FolderTree" ItemsSource="{Binding Folders}" SelectedItemChanged="FolderTree_OnSelectedItemChanged"
                      ui:RightClickSelect.IsEnabled="True">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Развернуть всё" Click="ExpandFolder_OnClick" />
                        <MenuItem Header="Свернуть всё" Click="CollapseFolder_OnClick">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.CollapseAll}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Обслуживание папки…" Click="MaintenanceFolder_OnClick"
                                  ToolTip="Обслуживание всех компонентов этой папки и вложенных">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.Database}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Обновить" InputGestureText="F5" Command="{Binding LoadCommand}">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.Refresh}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Image Source="{StaticResource Pdm.Icon.Folder}" Style="{StaticResource Pdm.Icon16}" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Pdm.Text.Hint}" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" Background="Transparent" />

            <DataGrid ui:NaturalSort.IsEnabled="True" x:Name="Grid" Grid.Column="2" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" IsReadOnly="True"
                      SelectionMode="Extended" MouseDoubleClick="Grid_OnMouseDoubleClick"
                      ui:RightClickSelect.IsEnabled="True" PreviewKeyDown="Grid_OnPreviewKeyDown">
                <!-- Команды по правой кнопке — те же, что на панели инструментов -->
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Изменить…" InputGestureText="Enter" Click="Edit_OnClick" FontWeight="SemiBold">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.Settings}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Дублировать…" Click="Duplicate_OnClick">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.LibraryAdd}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Показать файл" Click="ShowInWindows_OnClick">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.ShowInWindows}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Копировать обозначение" InputGestureText="Ctrl+C" Click="CopyDesignation_OnClick">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.CopyPath}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Обслуживание выделенных…" Click="Maintenance_OnClick">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.Database}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Обновить список" InputGestureText="F5" Command="{Binding LoadCommand}">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.Refresh}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Удалить" InputGestureText="Del" Click="Delete_OnClick">
                            <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.State.Error}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Обозначение" Width="360" SortMemberPath="Item.Designation">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Path}">
                                    <Image Source="{Binding Path, Converter={StaticResource Pdm.FileIcon}}" Style="{StaticResource Pdm.Icon16}" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding Item.Designation}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Тип" Width="100" Binding="{Binding KindName}" />
                    <DataGridTextColumn Header="Стандарт" Width="140" Binding="{Binding Item.Standard}" />
                    <DataGridTextColumn Header="Производитель" Width="120" Binding="{Binding Item.Manufacturer}" />
                    <DataGridTextColumn Header="Раздел" Width="220" Binding="{Binding Item.CategoryPath}" />
                    <DataGridTextColumn Header="Изменён" Width="*" Binding="{Binding Modified}" SortMemberPath="Item.ModifiedAt" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
