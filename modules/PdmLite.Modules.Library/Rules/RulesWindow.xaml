<Window x:Class="PdmLite.Modules.Library.Rules.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdmLite.Modules.Library.Rules"
        xmlns:ui="clr-namespace:PdmLite.UI.Shared;assembly=PdmLite.UI.Shared"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:RulesViewModel}"
        Title="Правила замены в обозначениях" Width="1100" Height="700" MinWidth="600" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="Pdm.Window" />
    </Window.Style>

    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Pdm.Text.Hint}" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Замены применяются сверху вниз к обозначению каждого файла при анализе (после приведения кодов к латинице). Формат обозначения по стандартам не проверяется. Правки, сделанные вручную, правила не меняют." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить и применить" IsDefault="True" Click="Save_OnClick" Margin="0,0,8,0" MinWidth="170" />
            <Button Content="Отмена" IsCancel="True" />
        </StackPanel>

        <!-- Проверка на примере -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Pdm.Brush.Border}" BorderThickness="1"
                Background="{StaticResource Pdm.Brush.Panel}" Padding="8,6" Margin="0,8,0,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="Проверить на примере" Style="{StaticResource Pdm.Text.Label}" Width="150" VerticalAlignment="Center" />
                    <TextBox Text="{Binding TestInput, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBox Text="{Binding TestResult, Mode=OneWay}" Style="{StaticResource Pdm.Text.Value}" Margin="150,4,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Errors}" Foreground="#C42B1C" TextWrapping="Wrap" Margin="150,4,0,0"
                           Visibility="{Binding Errors, Converter={x:Static ui:NullToVisibilityConverter.Instance}}" />
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Width="110">
            <Button Content="Добавить" Click="Add_OnClick" Margin="0,0,0,6" />
            <Button Content="Удалить" Click="Delete_OnClick" Margin="0,0,0,6" />
            <Button Content="Выше" Click="Up_OnClick" Margin="0,0,0,6" />
            <Button Content="Ниже" Click="Down_OnClick" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" CanUserAddRows="False" CanUserSortColumns="False"
                  SelectionMode="Single" ui:RightClickSelect.IsEnabled="True">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить правило" Click="Add_OnClick" />
                    <MenuItem Header="Удалить" Click="Delete_OnClick">
                        <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.State.Error}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Выше" Click="Up_OnClick" />
                    <MenuItem Header="Ниже" Click="Down_OnClick" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Вкл." Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Найти" Width="200" Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Заменить на" Width="160" Binding="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTemplateColumn Header="Рег. выражение" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsRegex, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                      ToolTip="«Найти» — регулярное выражение; в «Заменить на» можно $1, $2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Пояснение" Width="*" Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
