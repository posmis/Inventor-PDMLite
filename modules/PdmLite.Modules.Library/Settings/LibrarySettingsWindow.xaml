<Window x:Class="PdmLite.Modules.Library.Settings.LibrarySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdmLite.Modules.Library.Settings"
        xmlns:ui="clr-namespace:PdmLite.UI.Shared;assembly=PdmLite.UI.Shared"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:LibrarySettingsViewModel}"
        Title="Настройки библиотеки" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ui:IconKeyConverter x:Key="IconKey" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="Pdm.Window" />
    </Window.Style>

    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Сохранить" IsDefault="True" Click="Save_OnClick" Margin="0,0,8,0" />
            <Button Content="Отмена" IsCancel="True" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="База данных PostgreSQL" Style="{StaticResource Pdm.Text.Section}" Margin="0,0,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Сервер" Style="{StaticResource Pdm.Text.Label}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                <TextBlock Grid.Column="2" Text="Порт" Style="{StaticResource Pdm.Text.Label}" VerticalAlignment="Center" Margin="12,3,8,3" />
                <TextBox Grid.Column="3" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />

                <TextBlock Grid.Row="1" Text="База данных" Style="{StaticResource Pdm.Text.Label}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Database1, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />

                <TextBlock Grid.Row="2" Text="Пользователь" Style="{StaticResource Pdm.Text.Label}" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />

                <TextBlock Grid.Row="3" Text="Пароль" Style="{StaticResource Pdm.Text.Label}" VerticalAlignment="Center" />
                <PasswordBox x:Name="PasswordInput" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,3"
                             PasswordChanged="PasswordInput_OnPasswordChanged" />
            </Grid>
            <TextBlock Margin="120,0,0,0" Style="{StaticResource Pdm.Text.Hint}"
                       Text="Пароль сохранён. Оставьте поле пустым, чтобы не менять его.">
                <TextBlock.Visibility>
                    <Binding Path="HasSavedPassword">
                        <Binding.Converter>
                            <BooleanToVisibilityConverter />
                        </Binding.Converter>
                    </Binding>
                </TextBlock.Visibility>
            </TextBlock>

            <DockPanel Margin="120,8,0,0">
                <Button Command="{Binding TestCommand}" Style="{StaticResource Pdm.ToolButton}" DockPanel.Dock="Left" BorderBrush="#ADADAD">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Pdm.Icon.Cmd.Database}" Style="{StaticResource Pdm.Icon16}" />
                        <TextBlock Text="Проверить подключение" Margin="5,0,2,0" />
                    </StackPanel>
                </Button>
                <Image Source="{Binding TestIcon, Converter={StaticResource IconKey}}" Style="{StaticResource Pdm.Icon16}" Margin="10,0,5,0" />
                <TextBlock Text="{Binding TestMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="Папка библиотеки" Style="{StaticResource Pdm.Text.Section}" Margin="0,16,0,6" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Обзор…" Click="Browse_OnClick" Margin="8,0,0,0" />
                <TextBox Text="{Binding RootFolder, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource Pdm.Text.Hint}"
                       Text="Сюда раскладываются файлы компонентов. Папка подключается в проекты Inventor как библиотека «PdmLite»." />
        </StackPanel>
    </DockPanel>
</Window>
