<Window x:Class="PdmLite.Modules.Library.Backup.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdmLite.Modules.Library.Backup"
        xmlns:ui="clr-namespace:PdmLite.UI.Shared;assembly=PdmLite.UI.Shared"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:BackupViewModel}"
        Title="Резервные копии библиотеки" Width="1250" Height="780" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/PdmLite.UI.Shared;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <StaticResource ResourceKey="Pdm.Window" />
    </Window.Style>

    <DockPanel>
        <!-- Панель инструментов -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Pdm.Toolbar}" BorderBrush="{StaticResource Pdm.Brush.Border}">
            <ui:ToolbarPanel>
                <Button Style="{StaticResource Pdm.ToolButton}" Command="{Binding CreateCommand}" ToolTip="Копия базы и всех файлов библиотеки в ZIP-архив">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Pdm.Icon.Cmd.Database}" Style="{StaticResource Pdm.Icon16}" />
                        <TextBlock Text="Сделать копию сейчас" Margin="5,0,2,0" />
                    </StackPanel>
                </Button>
                <Rectangle Style="{StaticResource Pdm.ToolSeparator}" />
                <Button Style="{StaticResource Pdm.ToolButton}" Command="{Binding RestoreCommand}" ToolTip="Вернуть библиотеку к выбранной копии">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Pdm.Icon.Cmd.Refresh}" Style="{StaticResource Pdm.Icon16}" />
                        <TextBlock Text="Восстановить…" Margin="5,0,2,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Pdm.ToolButton}" Click="RestoreFromFile_OnClick" ToolTip="Восстановить из архива в другом месте (например, с флешки)">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Pdm.Icon.Cmd.Open}" Style="{StaticResource Pdm.Icon16}" />
                        <TextBlock Text="Восстановить из файла…" Margin="5,0,2,0" />
                    </StackPanel>
                </Button>
                <Rectangle Style="{StaticResource Pdm.ToolSeparator}" />
                <Button Style="{StaticResource Pdm.ToolButton}" Command="{Binding ShowCommand}" ToolTip="Показать архив в проводнике">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Pdm.Icon.Cmd.ShowInWindows}" Style="{StaticResource Pdm.Icon16}" />
                        <TextBlock Text="Показать файл" Margin="5,0,2,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Pdm.ToolButton}" Command="{Binding DeleteCommand}" ToolTip="Удалить выбранную копию">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource Pdm.Icon.State.Error}" Style="{StaticResource Pdm.Icon16}" />
                        <TextBlock Text="Удалить копию" Margin="5,0,2,0" />
                    </StackPanel>
                </Button>
            </ui:ToolbarPanel>
        </Border>

        <!-- Настройки -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Pdm.Brush.Toolbar}" BorderBrush="{StaticResource Pdm.Brush.Border}"
                BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Закрыть" IsCancel="True" Click="Close_OnClick" VerticalAlignment="Bottom" />
                <StackPanel>
                    <DockPanel Margin="0,0,12,4">
                        <TextBlock Text="Папка копий" Style="{StaticResource Pdm.Text.Label}" Width="110" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Сохранить настройки" Click="SaveSettings_OnClick" Margin="6,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Обзор…" Click="Browse_OnClick" Margin="6,0,0,0" />
                        <TextBox Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Хранить автоматических копий" Style="{StaticResource Pdm.Text.Label}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Keep, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0,16,0" />
                        <TextBlock Text="Копия по расписанию — раз в (дней, 0 — нет)" Style="{StaticResource Pdm.Text.Label}" VerticalAlignment="Center" />
                        <TextBox Text="{Binding IntervalDays, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Pdm.Text.Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Автоматически копия делается раз в указанное число дней (при запуске Explorer), перед обслуживанием библиотеки и перед восстановлением. Ручные копии сами не удаляются." />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="10,8,10,4">
            <TextBlock Text="{Binding Summary}" />
            <ProgressBar Height="4" Margin="0,4,0,0" Value="{Binding Progress}" Maximum="100"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Pdm.Text.Hint}" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <DataGrid x:Name="Grid" Margin="6" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True"
                  SelectionMode="Single" ui:RightClickSelect.IsEnabled="True" ui:NaturalSort.IsEnabled="True"
                  IsEnabled="{Binding IsBusy, Converter={x:Static ui:InverseBoolConverter.Instance}}">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Восстановить…" Command="{Binding RestoreCommand}" FontWeight="SemiBold">
                        <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.Refresh}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Показать файл" Command="{Binding ShowCommand}">
                        <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.ShowInWindows}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Сделать копию сейчас" Command="{Binding CreateCommand}">
                        <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.Cmd.Database}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Обновить список" Command="{Binding RefreshCommand}" />
                    <Separator />
                    <MenuItem Header="Удалить копию" Command="{Binding DeleteCommand}">
                        <MenuItem.Icon><Image Source="{StaticResource Pdm.Icon.State.Error}" Style="{StaticResource Pdm.Icon16}" /></MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Width="130" Binding="{Binding Created}" SortMemberPath="Info.Manifest.CreatedAt" />
                <DataGridTextColumn Header="Причина" Width="170" Binding="{Binding Reason}" />
                <DataGridTextColumn Header="Компонентов" Width="95" Binding="{Binding Items}" />
                <DataGridTextColumn Header="Файлов" Width="70" Binding="{Binding Files}" />
                <DataGridTextColumn Header="Размер" Width="80" Binding="{Binding Size}" SortMemberPath="Info.Size" />
                <DataGridTextColumn Header="Кто" Width="160" Binding="{Binding Who}" />
                <DataGridTextColumn Header="Файл" Width="*" MinWidth="200" Binding="{Binding FileName}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
