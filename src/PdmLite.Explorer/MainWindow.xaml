<Window x:Class="PdmLite.Explorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdmLite.Explorer"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MainViewModel}"
        Title="{Binding Title}" Width="1100" Height="700" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFolderCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="Открыть _папку проекта…" InputGestureText="Ctrl+O" Command="{Binding OpenFolderCommand}" />
                <MenuItem Header="Открыть _файл проекта (.ipj)…" Command="{Binding OpenProjectFileCommand}" />
                <MenuItem x:Name="RecentMenu" Header="_Недавние проекты" ItemsSource="{Binding RecentProjects}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, ElementName=RecentMenu}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Выход" Click="Exit_OnClick" />
            </MenuItem>
            <MenuItem Header="_Вид">
                <MenuItem Header="_Обновить" InputGestureText="F5" Command="{Binding RefreshCommand}" />
            </MenuItem>
            <!-- Пункты добавляют модули (команды с размещением Toolbar). -->
            <MenuItem x:Name="ToolsMenu" Header="_Сервис" SubmenuOpened="ToolsMenu_OnSubmenuOpened">
                <MenuItem Header="(нет команд)" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="_Справка">
                <MenuItem Header="_Модули…" Click="Modules_OnClick" />
                <MenuItem Header="_О программе" Click="About_OnClick" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding ProjectPath}" TextTrimming="CharacterEllipsis" MaxWidth="600" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Pdm.Brush.Offline}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInventorConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Pdm.Brush.Online}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding InventorStatus}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding ActiveDocument}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <!-- Панели модулей: слева навигация, справа сведения. -->
        <Grid x:Name="PanelsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="250" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="DetailsColumn" Width="2*" MinWidth="200" />
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="NavigatorHost" Grid.Column="0" />
            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" />
            <ContentControl x:Name="DetailsHost" Grid.Column="2" />
        </Grid>
    </DockPanel>
</Window>
