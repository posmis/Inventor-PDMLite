<Window x:Class="PdmLite.Explorer.ModulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PdmLite.UI.Shared;assembly=PdmLite.UI.Shared"
        Title="Модули" Width="700" Height="420" MinWidth="420" MinHeight="240"
        Style="{StaticResource Pdm.Window}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
    </Window.Resources>
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Закрыть" IsDefault="True" IsCancel="True" />
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Pdm.Text.Hint}"
                       Text="Модули включаются и отключаются в файле modules.json в папке программы." />
        </DockPanel>
        <ListView x:Name="List">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Модуль" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Icon, Converter={StaticResource Pdm.IconKey}}" Style="{StaticResource Pdm.Icon16}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Info.Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Идентификатор" Width="110" DisplayMemberBinding="{Binding Info.Id}" />
                    <GridViewColumn Header="Версия" Width="60" DisplayMemberBinding="{Binding Info.Version}" />
                    <GridViewColumn Header="Состояние" Width="190" DisplayMemberBinding="{Binding StateText}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
