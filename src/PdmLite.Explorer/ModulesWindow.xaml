<Window x:Class="PdmLite.Explorer.ModulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Модули" Width="560" Height="320" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource Pdm.Brush.Muted}"
                   Text="Модули включаются и отключаются в файле modules.json в папке программы." />
        <ListView x:Name="List">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Модуль" Width="180" DisplayMemberBinding="{Binding Info.Name}" />
                    <GridViewColumn Header="Id" Width="110" DisplayMemberBinding="{Binding Info.Id}" />
                    <GridViewColumn Header="Версия" Width="60" DisplayMemberBinding="{Binding Info.Version}" />
                    <GridViewColumn Header="Состояние" Width="180" DisplayMemberBinding="{Binding StateText}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
