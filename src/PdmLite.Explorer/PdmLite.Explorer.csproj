<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Apprentice — 64-битный COM-компонент Inventor: процесс тоже должен быть 64-битным. -->
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PdmLite.Explorer</AssemblyName>
    <ApplicationIcon>Assets\PdmLite.ico</ApplicationIcon>
    <Description>PdmLite Explorer — просмотр проекта без запуска Inventor.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdmLite.Core\PdmLite.Core.csproj" />
    <ProjectReference Include="..\PdmLite.Hosting\PdmLite.Hosting.csproj" />
    <ProjectReference Include="..\PdmLite.Link\PdmLite.Link.csproj" />
    <ProjectReference Include="..\PdmLite.UI.Shared\PdmLite.UI.Shared.csproj" />
    <!-- Свойства файлов Inventor без запуска Inventor (Apprentice). Нужен Inventor или Inventor View. -->
    <ProjectReference Include="..\PdmLite.Apprentice\PdmLite.Apprentice.csproj" />
  </ItemGroup>

  <!--
    Модули подключаются только ради копирования сборок в папку приложения.
    Код Explorer на них не ссылается: модули находятся при запуске (PdmLite.Modules.*.dll)
    и включаются/отключаются в modules.json.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\modules\PdmLite.Modules.ProjectTree\PdmLite.Modules.ProjectTree.csproj" />
    <ProjectReference Include="..\..\modules\PdmLite.Modules.Properties\PdmLite.Modules.Properties.csproj" />
    <ProjectReference Include="..\..\modules\PdmLite.Modules.InventorLink\PdmLite.Modules.InventorLink.csproj" />
    <ProjectReference Include="..\..\modules\PdmLite.Modules.Library\PdmLite.Modules.Library.csproj" />
    <ProjectReference Include="..\..\modules\PdmLite.Modules.References\PdmLite.Modules.References.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF-проекты не подключают System.IO неявно (конфликт имени Path с System.Windows.Shapes). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Update="modules.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\PdmLite.ico" />
  </ItemGroup>

</Project>
