<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Копировать в выходную папку все зависимости: Inventor загружает плагин из неё. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>PdmLite.AddIn</AssemblyName>
    <Description>Плагин PdmLite для Autodesk Inventor 2025.</Description>

    <!-- Путь к сборке Inventor API. Можно переопределить: dotnet build -p:InventorInteropPath=... -->
    <InventorInteropPath Condition="'$(InventorInteropPath)' == ''">$(ProgramW6432)\Autodesk\Inventor 2025\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll</InventorInteropPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorInteropPath)</HintPath>
      <!-- Сборку предоставляет сам Inventor: в папку плагина не копируем. -->
      <Private>False</Private>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdmLite.Core\PdmLite.Core.csproj" />
    <ProjectReference Include="..\PdmLite.Hosting\PdmLite.Hosting.csproj" />
    <ProjectReference Include="..\PdmLite.Link\PdmLite.Link.csproj" />
    <ProjectReference Include="..\PdmLite.UI.Shared\PdmLite.UI.Shared.csproj" />
  </ItemGroup>

  <!-- Модули: только для копирования сборок, см. комментарий в PdmLite.Explorer.csproj. -->
  <ItemGroup>
    <ProjectReference Include="..\..\modules\PdmLite.Modules.ProjectTree\PdmLite.Modules.ProjectTree.csproj" />
    <ProjectReference Include="..\..\modules\PdmLite.Modules.Properties\PdmLite.Modules.Properties.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="Inventor" Alias="Inv" />
  </ItemGroup>

  <ItemGroup>
    <None Update="modules.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckInventorInterop" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(InventorInteropPath)')">
    <Error Text="Не найдена сборка Inventor API: $(InventorInteropPath). Установите Inventor 2025 или укажите путь: dotnet build -p:InventorInteropPath=..." />
  </Target>

</Project>
