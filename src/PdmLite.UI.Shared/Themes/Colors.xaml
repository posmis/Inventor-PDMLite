<!--
  Палитра PdmLite. Светлая нейтральная схема в духе Inventor: серые панели,
  белые рабочие области, один синий акцент. Цвет никогда не единственный носитель
  смысла — состояние дублируется текстом или иконкой.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Поверхности -->
    <Color x:Key="Pdm.Color.Window">#F0F0F0</Color>          <!-- фон окна, рамки -->
    <Color x:Key="Pdm.Color.Panel">#FFFFFF</Color>           <!-- рабочие области: дерево, карточка -->
    <Color x:Key="Pdm.Color.Toolbar">#F5F5F5</Color>         <!-- панели инструментов, строка состояния -->
    <Color x:Key="Pdm.Color.SectionHeader">#EDEDED</Color>   <!-- заголовки разделов -->

    <!-- Линии -->
    <Color x:Key="Pdm.Color.Border">#C6C6C6</Color>
    <Color x:Key="Pdm.Color.Divider">#E1E1E1</Color>
    <Color x:Key="Pdm.Color.InputBorder">#ABADB3</Color>

    <!-- Текст -->
    <Color x:Key="Pdm.Color.Text">#1E1E1E</Color>
    <Color x:Key="Pdm.Color.TextSecondary">#5F5F5F</Color>
    <Color x:Key="Pdm.Color.TextDisabled">#A0A0A0</Color>

    <!-- Акцент и выделение -->
    <Color x:Key="Pdm.Color.Accent">#0696D7</Color>
    <Color x:Key="Pdm.Color.AccentPressed">#0573A5</Color>
    <Color x:Key="Pdm.Color.Hover">#E5F3FB</Color>
    <Color x:Key="Pdm.Color.HoverBorder">#A8D8F0</Color>
    <Color x:Key="Pdm.Color.Selected">#CCE8F7</Color>
    <Color x:Key="Pdm.Color.SelectedBorder">#7FC3E8</Color>
    <Color x:Key="Pdm.Color.SelectedInactive">#E4E4E4</Color>
    <Color x:Key="Pdm.Color.Pressed">#B8DDF2</Color>

    <!-- Состояния -->
    <Color x:Key="Pdm.Color.Success">#2E8540</Color>
    <Color x:Key="Pdm.Color.Warning">#9A6400</Color>
    <Color x:Key="Pdm.Color.Error">#C42B1C</Color>

    <SolidColorBrush x:Key="Pdm.Brush.Window" Color="{StaticResource Pdm.Color.Window}" />
    <SolidColorBrush x:Key="Pdm.Brush.Panel" Color="{StaticResource Pdm.Color.Panel}" />
    <SolidColorBrush x:Key="Pdm.Brush.Toolbar" Color="{StaticResource Pdm.Color.Toolbar}" />
    <SolidColorBrush x:Key="Pdm.Brush.SectionHeader" Color="{StaticResource Pdm.Color.SectionHeader}" />
    <SolidColorBrush x:Key="Pdm.Brush.Border" Color="{StaticResource Pdm.Color.Border}" />
    <SolidColorBrush x:Key="Pdm.Brush.Divider" Color="{StaticResource Pdm.Color.Divider}" />
    <SolidColorBrush x:Key="Pdm.Brush.InputBorder" Color="{StaticResource Pdm.Color.InputBorder}" />
    <SolidColorBrush x:Key="Pdm.Brush.Text" Color="{StaticResource Pdm.Color.Text}" />
    <SolidColorBrush x:Key="Pdm.Brush.TextSecondary" Color="{StaticResource Pdm.Color.TextSecondary}" />
    <SolidColorBrush x:Key="Pdm.Brush.TextDisabled" Color="{StaticResource Pdm.Color.TextDisabled}" />
    <SolidColorBrush x:Key="Pdm.Brush.Accent" Color="{StaticResource Pdm.Color.Accent}" />
    <SolidColorBrush x:Key="Pdm.Brush.AccentPressed" Color="{StaticResource Pdm.Color.AccentPressed}" />
    <SolidColorBrush x:Key="Pdm.Brush.Hover" Color="{StaticResource Pdm.Color.Hover}" />
    <SolidColorBrush x:Key="Pdm.Brush.HoverBorder" Color="{StaticResource Pdm.Color.HoverBorder}" />
    <SolidColorBrush x:Key="Pdm.Brush.Selected" Color="{StaticResource Pdm.Color.Selected}" />
    <SolidColorBrush x:Key="Pdm.Brush.SelectedBorder" Color="{StaticResource Pdm.Color.SelectedBorder}" />
    <SolidColorBrush x:Key="Pdm.Brush.SelectedInactive" Color="{StaticResource Pdm.Color.SelectedInactive}" />
    <SolidColorBrush x:Key="Pdm.Brush.Pressed" Color="{StaticResource Pdm.Color.Pressed}" />
    <SolidColorBrush x:Key="Pdm.Brush.Success" Color="{StaticResource Pdm.Color.Success}" />
    <SolidColorBrush x:Key="Pdm.Brush.Warning" Color="{StaticResource Pdm.Color.Warning}" />
    <SolidColorBrush x:Key="Pdm.Brush.Error" Color="{StaticResource Pdm.Color.Error}" />

    <!-- Шрифт: как в интерфейсе Inventor и Windows -->
    <FontFamily x:Key="Pdm.FontFamily">Segoe UI</FontFamily>
    <sys:Double x:Key="Pdm.FontSize">12</sys:Double>
    <sys:Double x:Key="Pdm.FontSize.Small">11</sys:Double>
    <sys:Double x:Key="Pdm.FontSize.Title">15</sys:Double>

</ResourceDictionary>
